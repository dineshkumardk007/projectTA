# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Any PostgreSQL 14+ instance. `pnpm db:local` prints a ready-to-paste URL for
# the bundled local server if you do not have Docker or a managed database.
DATABASE_URL="postgresql://takeaway:takeaway@localhost:55432/takeaway"

# Auth ----------------------------------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime in days.
AUTH_SESSION_DAYS="30"

# Public app URL — used for QR deep links and push notification click targets.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Maps / geo ----------------------------------------------------------------
# Provider: "haversine" (no key, straight-line distance + walking speed model)
# or "google" (requires MAPS_API_KEY).
MAPS_PROVIDER="haversine"
MAPS_API_KEY=""

# Payments ------------------------------------------------------------------
# Provider: "mock" (no key, simulates success/failure for local testing) or
# "razorpay" (requires the key pair below).
PAYMENTS_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Push notifications --------------------------------------------------------
# Provider: "mock" (logs instead of sending) or "webpush" (requires VAPID keys).
# Generate VAPID keys with:  pnpm exec web-push generate-vapid-keys
PUSH_PROVIDER="mock"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@takeaway.example"

# Email ---------------------------------------------------------------------
# Provider: "console" (prints messages, including password-reset links, to the
# server log) or "resend" (requires an API key).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Takeaway <no-reply@takeaway.example>"

# Object storage ------------------------------------------------------------
# Provider: "local" (writes to ./public/uploads for $0 dev) or "s3" (Cloudflare R2 / AWS S3 / MinIO).
#
# Cloudflare R2 Example (10 GB Free Storage, $0 Egress):
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="takeaway-uploads"
# S3_ACCESS_KEY_ID="your-r2-access-key-id"
# S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# S3_PUBLIC_BASE_URL="https://pub-<hash>.r2.dev"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
